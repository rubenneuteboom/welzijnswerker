        function getSIJNNetwerkPositie() {
            // Tel alle supporters over alle domeinen
            let totalSupporters = 0;
            let informalCount = 0;
            let formalCount = 0;
            let collectiveCount = 0;
            let geenNetwerkDomeinen = 0;
            
            domains.forEach(domain => {
                const details = state.domainDetails[domain.id] || {};
                const supporters = details.supporters || [];
                const inzet = details.inzet || [];
                
                if (inzet.includes('geen')) {
                    geenNetwerkDomeinen++;
                }
                
                supporters.forEach(s => {
                    totalSupporters++;
                    if (s.type === 'informal') informalCount++;
                    else if (s.type === 'professional') formalCount++;
                    else if (s.type === 'collective') collectiveCount++;
                });
            });
            
            // Bepaal netwerkpositie
            let positie = '';
            let label = '';
            let beschrijving = '';
            
            if (totalSupporters === 0 || geenNetwerkDomeinen >= 8) {
                positie = 'geen';
                label = 'Geen netwerk';
                beschrijving = 'Er is momenteel weinig tot geen georganiseerde steun.';
            } else if (totalSupporters === 1 || (totalSupporters <= 2 && formalCount === totalSupporters)) {
                positie = '1-persoons';
                label = '1-persoonsnetwerk';
                beschrijving = 'Op dit moment is de steun vooral georganiseerd via één persoon.';
            } else if (formalCount === 0 && informalCount > 0) {
                positie = 'informeel';
                label = 'Informeel netwerk';
                beschrijving = 'De steun komt vooral van mensen uit de directe omgeving.';
            } else if (informalCount === 0 && formalCount > 0) {
                positie = 'formeel';
                label = 'Formeel netwerk';
                beschrijving = 'De steun komt vooral van professionals en voorzieningen.';
            } else if (informalCount > 0 && formalCount > 0) {
                positie = 'gemengd';
                label = 'Gemengd netwerk';
                beschrijving = 'Er is een mix van informele en professionele steun.';
            } else {
                positie = 'informeel';
                label = 'Informeel netwerk';
                beschrijving = 'De steun komt vooral van mensen uit de directe omgeving.';
            }
            
            return {
                positie,
                label,
                beschrijving,
                totalSupporters,
                informalCount,
                formalCount,
                collectiveCount
            };
        }
        
