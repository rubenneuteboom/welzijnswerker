        // Update risk alert based on current scores
        function updateRiskAlert() {
            const alertContainer = document.getElementById('riskAlert');
            if (!alertContainer) return;
            
            const risks = [];
            let criticalCount = 0;
            let vulnerableCount = 0;
            
            // Check each domain
            domains.forEach(domain => {
                const score = state.scores[domain.id];
                const details = state.domainDetails[domain.id] || {};
                const dekking = details.dekking || 'missing';
                
                // Critical: score 1 (red)
                if (score === 1) {
                    criticalCount++;
                    // Extra critical if no network coverage on important domains
                    if (['geestelijk', 'huisvesting', 'financien'].includes(domain.id) && dekking === 'missing') {
                        risks.push(`${domain.emoji} ${domain.name}: acute situatie zonder netwerk`);
                    }
                }
                
                // Vulnerable: score 2 (yellow)
                if (score === 2) {
                    vulnerableCount++;
                }
                
                // Check for hindering network on multiple domains
                const supporters = details.supporters || [];
                supporters.forEach(s => {
                    if (s.effect === 'Belemmerend') {
                        const otherDomains = domains.filter(d => {
                            const dDetails = state.domainDetails[d.id] || {};
                            const dSupporters = dDetails.supporters || [];
                            return dSupporters.some(ds => ds.name === s.name && ds.effect === 'Belemmerend');
                        });
                        if (otherDomains.length > 2) {
                            const existing = risks.find(r => r.includes(s.name));
                            if (!existing) {
                                risks.push(`⚠️ ${s.name} is belemmerend op ${otherDomains.length} domeinen`);
                            }
                        }
                    }
                });
            });
            
            // Show alert if there are risks
            if (criticalCount >= 3 || risks.length > 0) {
                const severity = criticalCount >= 3 ? 'critical' : 'warning';
                const icon = severity === 'critical' ? '🚨' : '⚠️';
                const title = severity === 'critical' ? 
                    `Let op: ${criticalCount} acute situaties` : 
                    'Aandachtspunten gevonden';
                
                alertContainer.innerHTML = `
                    <div class="risk-alert ${severity === 'warning' ? 'warning' : ''}">
                        <div class="risk-alert-icon">${icon}</div>
                        <div class="risk-alert-content">
                            <div class="risk-alert-title">${title}</div>
                            ${vulnerableCount > 0 ? `<div style="font-size: 0.9rem; color: #7f1d1d; margin-top: 3px;">${vulnerableCount} kwetsbare domeinen</div>` : ''}
                            ${risks.length > 0 ? `
                                <ul class="risk-alert-items">
                                    ${risks.map(r => `<li>${r}</li>`).join('')}
                                </ul>
                            ` : ''}
                        </div>
                    </div>
                `;
                alertContainer.style.display = 'block';
            } else {
                alertContainer.style.display = 'none';
            }
        }
        
