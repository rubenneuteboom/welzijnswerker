        // Render results
        let radarChart = null;
        function renderResults() {
            const ctx = document.getElementById('radarChart').getContext('2d');
            
            if (radarChart) radarChart.destroy();

            const labels = domains.map(d => d.name);
            const data = domains.map(d => state.scores[d.id] || 0);
            
            // Kleur per punt op basis van netwerktype
            const pointColors = domains.map(d => {
                const details = state.domainDetails[d.id] || {};
                const inzet = details.inzet || [];
                
                // Prioriteit: formeel > collectief > informeel > geen
                if (inzet.includes('formal')) return '#ef4444'; // Rood = Formeel
                if (inzet.includes('collective')) return '#8b5cf6'; // Paars = Collectief
                if (inzet.includes('informal')) return '#f59e0b'; // Oranje = Informeel
                if (inzet.includes('geen')) return '#94a3b8'; // Grijs = Geen netwerk
                return '#d1d5db'; // Lichtgrijs = Niet ingevuld
            });

            radarChart = new Chart(ctx, {
                type: 'radar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Zelfredzaamheid',
                        data: data,
                        backgroundColor: 'rgba(46, 204, 113, 0.15)',
                        borderColor: '#2ECC71',
