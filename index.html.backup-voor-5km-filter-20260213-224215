        async function searchBraveActivities() {
            const postcode = state.postcode || '';
            const resultsContainer = document.getElementById('braveSearchResults');
            const resultsList = document.getElementById('braveResultsList');
            const btn = document.getElementById('btnSearchBrave');
            
            if (!BRAVE_API_KEY) {
                alert('Brave Search API key niet ingesteld.\\n\\nVoor online zoeken:\\n1. Ga naar https://brave.com/search/api/\\n2. Maak een gratis account (2000 queries/maand)\\n3. Voeg de API key toe in de code');
                return;
            }
            
            // Get lowest domains for search context
            const sortedDomains = [...domains].sort((a, b) => 
                (state.scores[a.id] || 5) - (state.scores[b.id] || 5)
            );
            const lowestDomains = sortedDomains.slice(0, 2).map(d => d.name);
            
            // Build search query
            const postcodeArea = postcode.substring(0, 4);
            const searchTerms = [
                `welzijn activiteiten ${postcodeArea}`,
                lowestDomains[0] ? lowestDomains[0].toLowerCase() : '',
                'buurt sociaal'
            ].filter(Boolean).join(' ');
            
