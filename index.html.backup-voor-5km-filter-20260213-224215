        // Load from localStorage
        function loadState() {
            const saved = localStorage.getItem('welzijnswerker_v2');
            if (saved) {
                const parsed = JSON.parse(saved);
                // Ensure history object exists (migration from older versions)
                if (!parsed.history) {
                    parsed.history = {
                        assessments: [],
                        networkChanges: [],
                        adviceLog: [],
                        activityLog: [],
                        kanbanLog: []
                    };
                }
                // Migrate scores from 1-10 to 1-5 scale
                if (parsed.scores) {
                    Object.keys(parsed.scores).forEach(key => {
                        const oldScore = parsed.scores[key];
                        if (oldScore > 5) {
                            // Convert 1-10 to 1-5: Math.ceil(score / 2)
                            parsed.scores[key] = Math.ceil(oldScore / 2);
                        }
                    });
                }
                state = {...state, ...parsed};
            }
            // Set clientId if not exists
            if (!state.clientId) {
                state.clientId = 'client_' + Date.now();
                state.createdAt = new Date().toISOString();
            }
        }

