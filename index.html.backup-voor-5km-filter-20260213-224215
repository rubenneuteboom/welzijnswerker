                // Log the search
                logActivityInteraction(0, 'brave_search', 'brave');
                
            } catch (error) {
                console.error('Brave Search error:', error);
                resultsList.innerHTML = `
                    <div style="background: #FFF3CD; border: 1px solid #FFE69C; border-radius: 8px; padding: 15px;">
                        <strong>⚠️ Zoeken mislukt</strong><br>
