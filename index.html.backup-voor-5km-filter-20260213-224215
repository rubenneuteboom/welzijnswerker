        function exportToICS() {
            if (!state.agendaActivities || state.agendaActivities.length === 0) {
                alert('Geen activiteiten om te exporteren.');
                return;
            }

            const formatDate = (dateStr) => {
                return dateStr.replace(/-/g, '') + 'T090000';
            };

            let ics = `BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Welzijnswerker//SIJN Agenda//NL
CALSCALE:GREGORIAN
METHOD:PUBLISH
`;

            state.agendaActivities.forEach(activity => {
                ics += `BEGIN:VEVENT
DTSTART:${formatDate(activity.date)}
DTEND:${formatDate(activity.date)}
SUMMARY:${activity.title}
DESCRIPTION:${activity.description}
STATUS:${activity.status === 'afgerond' ? 'COMPLETED' : 'CONFIRMED'}
END:VEVENT
`;
            });

            ics += 'END:VCALENDAR';

            const blob = new Blob([ics], { type: 'text/calendar' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'sijn-agenda.ics';
            a.click();
            URL.revokeObjectURL(url);
        }

