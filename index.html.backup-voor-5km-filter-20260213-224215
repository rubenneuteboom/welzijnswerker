        // Render ratings for network members
        function renderRatings() {
            const container = document.getElementById('ratingsList');
            
            if (state.network.length === 0) {
                container.innerHTML = '<p style="text-align: center; color: var(--text-light); padding: 20px;">U heeft nog geen personen toegevoegd aan uw netwerk. Ga terug om personen toe te voegen.</p>';
