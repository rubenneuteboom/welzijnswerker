                renderKanban();
                closeEditCardModal();
            }
        }

        // Drag and drop
        let draggedCardId = null;

        function handleDragStart(e, cardId) {
            draggedCardId = cardId;
            // Small delay to allow the drag image to be captured first
            setTimeout(() => {
                e.target.classList.add('dragging');
            }, 0);
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', cardId);
        }

        function handleDragEnd(e) {
            e.target.classList.remove('dragging');
            draggedCardId = null;
            // Remove all drag-over states
            document.querySelectorAll('.kanban-cards').forEach(col => {
                col.classList.remove('drag-over');
            });
        }

        function handleDragOver(e) {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            // Add visual feedback to the column
            const column = e.currentTarget;
            if (!column.classList.contains('drag-over')) {
                column.classList.add('drag-over');
            }
        }

        function handleDragLeave(e) {
            // Only remove if we're leaving the column entirely
            const column = e.currentTarget;
            const rect = column.getBoundingClientRect();
            const x = e.clientX;
            const y = e.clientY;
            
            if (x < rect.left || x > rect.right || y < rect.top || y > rect.bottom) {
                column.classList.remove('drag-over');
            }
        }

        function handleDrop(e, column) {
            e.preventDefault();
            e.currentTarget.classList.remove('drag-over');
            
            if (draggedCardId) {
                const card = state.kanbanCards.find(c => c.id === draggedCardId);
                if (card && card.column !== column) {
                    const fromColumn = card.column;
                    card.column = column;
                    logKanbanMove(card.id, fromColumn, column);
                    saveState();
                    // Add a small animation effect
                    renderKanban();
                    const cardEl = document.getElementById(`card-${card.id}`);
                    if (cardEl) {
                        cardEl.style.animation = 'dropBounce 0.3s ease';
                        setTimeout(() => cardEl.style.animation = '', 300);
                    }
                } else {
                    renderKanban();
                }
            }
        }

        // Render summary
        function renderSummary() {
            const date = new Date().toLocaleDateString('nl-NL');
            
            // Hulpvraag section
            if (state.hulpvraag || state.wens || state.clientName) {
                document.getElementById('summaryHulpvraag').style.display = 'block';
                document.getElementById('summaryHulpvraagContent').innerHTML = `
                    ${state.clientName ? `<p><strong>Cliënt:</strong> ${state.clientName}</p>` : ''}
                    ${state.clientBirthdate ? `<p><strong>Geboortedatum:</strong> ${new Date(state.clientBirthdate).toLocaleDateString('nl-NL')}</p>` : ''}
                    ${state.hulpvraag ? `<p><strong>Hulpvraag:</strong> ${state.hulpvraag}</p>` : ''}
                    ${state.wens ? `<p><strong>Belangrijkste wens:</strong> ${state.wens}</p>` : ''}
                `;
            }

            // Scores overview
            const sortedDomains = [...domains].sort((a, b) => 
                (state.scores[a.id] || 5) - (state.scores[b.id] || 5)
            );

            document.getElementById('summaryScores').innerHTML = `
                <p><strong>Datum:</strong> ${date}</p>
                ${state.mode === 'professional' ? `<p><strong>Professional:</strong> ${state.professionalName || 'Niet ingevuld'}</p>` : ''}
                <p><strong>Postcode:</strong> ${state.postcode || 'Niet ingevuld'}</p>
                <div style="margin-top: 15px;">
                    ${sortedDomains.map(d => {
                        const score = state.scores[d.id] || 0;
                        const emoji = score === 1 ? '🔴' : score === 2 ? '🟡' : score === 3 ? '🟢' : '⚪';
                        const color = score === 1 ? '#dc2626' : score === 2 ? '#eab308' : score === 3 ? '#10b981' : '#94a3b8';
                        return `
                        <div style="display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid #eee;">
                            <span>${d.emoji}</span>
                            <span style="flex: 1;">${d.name}</span>
                            <strong style="color: ${color}; font-size: 1.2rem;">
                                ${emoji}
                            </strong>
                        </div>
                        `;
                    }).join('')}
                </div>
            `;

            // Network summary
            const informal = state.network.filter(p => ['familie', 'vriend', 'buur', 'collega'].includes(p.type)).length;
            const formal = state.network.filter(p => p.type === 'professional').length;
            const networkInfo = getNetworkType();

            document.getElementById('summaryNetwork').innerHTML = `
                <p><strong>Netwerktype:</strong> <span class="network-type-badge ${networkInfo.className}" style="padding: 5px 15px; font-size: 0.9rem;">${networkInfo.label}</span></p>
                <p><strong>Totaal personen:</strong> ${state.network.length}</p>
                <p><strong>Informele contacten:</strong> ${informal}</p>
                <p><strong>Professionele contacten:</strong> ${formal}</p>
                <div style="margin-top: 10px;">
                    ${state.network.map(p => `
                        <span style="display: inline-block; background: ${typeColors[p.type]}20; color: ${typeColors[p.type]}; padding: 4px 12px; border-radius: 15px; margin: 3px; font-size: 0.9rem;">
                            ${p.name}
                        </span>
                    `).join('')}
                </div>
            `;

            // Professional notes
            if (state.mode === 'professional') {
                const notesWithContent = Object.entries(state.notes).filter(([_, note]) => note.trim());
                if (notesWithContent.length > 0) {
                    document.getElementById('summaryNotesSection').style.display = 'block';
                    document.getElementById('summaryNotes').innerHTML = `
                        <div class="notes-list">
                            ${notesWithContent.map(([domainId, note]) => {
                                const domain = domains.find(d => d.id === domainId);
                                return `
                                    <div class="note-item">
                                        <strong>${domain.emoji} ${domain.name}:</strong>
                                        <p>${note}</p>
                                    </div>
                                `;
                            }).join('')}
                        </div>
                    `;
                }
            }

            // Priorities (score 1 of 2 = aandacht nodig)
            const priorities = sortedDomains.filter(d => {
                const score = state.scores[d.id] || 0;
                return score > 0 && score <= 2;
            });
            document.getElementById('summaryPriorities').innerHTML = priorities.length > 0
                ? priorities.map(d => {
                    const score = state.scores[d.id];
                    const emoji = score === 1 ? '🔴' : '🟡';
                    const label = score === 1 ? 'Kritiek' : 'Kwetsbaar';
                    return `
                    <div style="display: flex; align-items: center; gap: 10px; padding: 10px; background: ${score === 1 ? '#FEF2F2' : '#FEFCE8'}; border-radius: 10px; margin: 8px 0;">
                        <span style="font-size: 1.5rem;">${d.emoji}</span>
                        <div>
                            <strong>${d.name}</strong>
                            <p style="color: var(--text-light); font-size: 0.9rem;">${emoji} ${label} - Aandacht nodig</p>
                        </div>
                    </div>
                    `;
                }).join('')
                : '<p style="color: var(--secondary);">✓ Geen domeinen met urgente aandacht nodig</p>';

            // Selected activities
            if (state.selectedActivities && state.selectedActivities.length > 0) {
                document.getElementById('summaryActiviteitenSection').style.display = 'block';
                const selected = state.activities.filter(a => state.selectedActivities.includes(a.id));
                document.getElementById('summaryActiviteiten').innerHTML = `
                    <ul>
                        ${selected.map(a => `<li><strong>${a.title}</strong> - ${a.description}</li>`).join('')}
                    </ul>
                `;
            }
        }

        // Reset all
        function resetAll() {
            if (confirm('Weet je zeker dat je opnieuw wilt beginnen? Alle gegevens worden gewist.')) {
                localStorage.removeItem('welzijnswerker_v2');
                state = {
                    version: '2.9',
                    clientId: 'client_' + Date.now(),
                    createdAt: new Date().toISOString(),
                    updatedAt: null,
                    mode: null,
                    professionalName: '',
                    postcode: '',
                    clientName: '',
                    clientBirthdate: '',
                    hulpvraag: '',
                    wens: '',
                    scores: {},
                    notes: {},
                    domainDetails: {},
                    network: [],
                    ratings: {},
                    ratingNotes: {},
                    currentScreen: 1,
                    currentView: 'assessment',
                    kanbanCards: [],
                    gptAdviceInterventions: [],
                    activities: [],
                    selectedActivities: [],
                    agendaActivities: [],
                    agendaMonth: new Date().getMonth(),
                    agendaYear: new Date().getFullYear(),
                    cachedProAdvice: null,
                    cachedClientAdvice: null,
                    history: {
                        assessments: [],
                        networkChanges: [],
                        adviceLog: [],
                        activityLog: [],
                        kanbanLog: []
                    }
                };
                document.querySelectorAll('.mode-card').forEach(c => c.classList.remove('selected'));
                document.getElementById('professionalFields').style.display = 'none';
                document.getElementById('postcode').value = '';
                document.getElementById('professionalName').value = '';
                goToScreen(1);
            }
        }

        // Initialize
        loadState();
        renderProgressSteps();
        
        // Herstel doelgroep-checkboxes
        if (state.doelgroepen && state.doelgroepen.length > 0) {
            state.doelgroepen.forEach(doelgroep => {
                const checkbox = document.getElementById(`doelgroep-${doelgroep}`);
                if (checkbox) {
                    checkbox.checked = true;
                }
            });
        }
        
        // Als geen mode gekozen, toon intro
        if (!state.mode) {
            // Toon intro-scherm
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById('screen-intro').classList.add('active');
        } else if (state.currentScreen > 1) {
            goToScreen(state.currentScreen);
        } else {
            // Mode is gekozen, maar nog op scherm 1 (start)
            goToScreen(1);
        }
        
        if (state.mode) {
            document.querySelector(`[data-mode="${state.mode}"]`)?.classList.add('selected');
            if (state.mode === 'professional') {
                document.getElementById('professionalFields').style.display = 'block';
                document.getElementById('professionalName').value = state.professionalName || '';
            }
        }
        if (state.postcode) {
            document.getElementById('postcode').value = state.postcode;
        }
    </script>
</body>
</html>