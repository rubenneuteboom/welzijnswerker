        function renderAgendaCalendar() {
            const months = ['Januari', 'Februari', 'Maart', 'April', 'Mei', 'Juni', 
                           'Juli', 'Augustus', 'September', 'Oktober', 'November', 'December'];
            
            document.getElementById('agendaMonth').textContent = `${months[state.agendaMonth]} ${state.agendaYear}`;
            
            const grid = document.getElementById('agendaGrid');
            const firstDay = new Date(state.agendaYear, state.agendaMonth, 1);
            const lastDay = new Date(state.agendaYear, state.agendaMonth + 1, 0);
            const today = new Date();
            
            // Get first Monday
            let startDate = new Date(firstDay);
            const dayOfWeek = firstDay.getDay();
            const daysToSubtract = dayOfWeek === 0 ? 6 : dayOfWeek - 1;
            startDate.setDate(startDate.getDate() - daysToSubtract);
            
            let html = '';
            for (let i = 0; i < 42; i++) { // 6 weeks max
                const currentDate = new Date(startDate);
                currentDate.setDate(startDate.getDate() + i);
                
                const isOtherMonth = currentDate.getMonth() !== state.agendaMonth;
                const isToday = currentDate.toDateString() === today.toDateString();
                const dateStr = currentDate.toISOString().split('T')[0];
                
                // Find activities for this day
                const dayActivities = (state.agendaActivities || []).filter(a => a.date === dateStr);
                
                html += `
                    <div class="agenda-day ${isOtherMonth ? 'other-month' : ''} ${isToday ? 'today' : ''}">
                        <div class="agenda-day-number">${currentDate.getDate()}</div>
                        ${dayActivities.map(a => `
                            <div class="agenda-event ${a.priority} ${a.status === 'afgerond' ? 'completed' : ''}" 
                                 title="${a.title}">${a.title}</div>
                        `).join('')}
                    </div>
                `;
            }
            
            grid.innerHTML = html;
        }

