                        </div>
                        <div>
                            <strong>${person.name}</strong>
                            <p style="font-size: 0.85rem; color: var(--text-light);">Hoe tevreden bent u met de steun van ${person.name}?</p>
                        </div>
                    </div>
                    <div class="rating-slider-container">
                        <input type="range" class="rating-slider" 
                            id="rating-slider-${person.id}" 
                            min="1" max="10" 
                            value="${state.ratings[person.id] || 5}"
                            oninput="updateRatingDisplay(${person.id}, this.value)">
                        <span class="rating-value" id="rating-value-${person.id}">${state.ratings[person.id] || 5}</span>
                    </div>
                    <textarea id="rating-note-${person.id}" placeholder="Korte toelichting (optioneel)...">${state.ratingNotes[person.id] || ''}</textarea>
                </div>
            `).join('');

            updateAverageRating();
            document.getElementById('averageRatingBox').style.display = 'block';
        }

        // Update rating display
        function updateRatingDisplay(personId, value) {
            document.getElementById(`rating-value-${personId}`).textContent = value;
            state.ratings[personId] = parseInt(value);
            saveState();
            updateAverageRating();
        }

        // Calculate and display average rating
        function updateAverageRating() {
            const ratings = state.network.map(p => state.ratings[p.id] || 5);
            if (ratings.length > 0) {
                const avg = ratings.reduce((a, b) => a + b, 0) / ratings.length;
                document.getElementById('averageRatingValue').textContent = avg.toFixed(1);
            }
        }

