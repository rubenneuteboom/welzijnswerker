        function copyToClipboard() {
            let summary = '=== SIJN Domeinoverzicht ===\n\n';
            
            domains.forEach(domain => {
                const score = state.scores[domain.id];
                const label = score ? getZelfredzaamheidLabel(domain.id, score) : { niveau: 'Niet ingevuld' };
                const details = state.domainDetails[domain.id] || {};
                const supporters = details.supporters || [];
                const dekking = details.dekking || 'missing';
                
                summary += `${domain.emoji} ${domain.name}\n`;
                summary += `  Zelfredzaamheid: ${label.niveau}\n`;
                summary += `  Dekking: ${dekking === 'ok' ? '✅ Voldoende' : dekking === 'vulnerable' ? '⚠️ Kwetsbaar' : '❌ Ontbreekt'}\n`;
                if (supporters.length > 0) {
                    summary += `  Netwerk: ${supporters.map(s => s.name).join(', ')}\n`;
                }
                summary += '\n';
            });
            
            // Client info
            if (state.clientName) {
                summary = `Naam: ${state.clientName}\n${state.clientBirthdate ? `Geboortedatum: ${state.clientBirthdate}\n` : ''}\n${summary}`;
            }
            
            // Copy to clipboard
            navigator.clipboard.writeText(summary).then(() => {
                alert('✅ Samenvatting gekopieerd naar klembord!');
            }).catch(() => {
                alert('❌ Kon niet kopiëren. Probeer handmatig te selecteren.');
