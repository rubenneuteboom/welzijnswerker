            if (!state.history) return;
            state.history.activityLog.push({
                date: new Date().toISOString(),
                activityId: activityId,
                action: action, // 'view', 'select', 'deselect', 'complete'
                source: source || 'static' // 'static', 'api', 'gpt'
            });
        }

