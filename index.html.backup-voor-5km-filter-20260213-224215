        function addSelectedToAgenda() {
            // Get selected local activities
            const selected = lokaleActiviteiten.filter(a => state.selectedActivities.includes(a.id));
            
            if (selected.length === 0) return;
            
            // Add to agenda with dates spread over coming weeks
            const today = new Date();
            const newAgendaActivities = selected.map((activity, i) => {
                const weekOffset = Math.floor(i / 2) + 1;
                const date = new Date(today);
                date.setDate(date.getDate() + (weekOffset * 7) + (i % 2) * 3);
                
                return {
                    id: activity.id,
                    title: activity.name,
                    description: `${activity.typeName} - ${activity.dagen} ${activity.tijd}`,
                    address: activity.address,
                    date: date.toISOString().split('T')[0],
                    status: 'gepland',
                    type: activity.type,
                    icon: activity.icon
                };
            });
            
            // Merge with existing agenda activities (avoid duplicates)
            const existingIds = state.agendaActivities.map(a => a.id);
            const newItems = newAgendaActivities.filter(a => !existingIds.includes(a.id));
            state.agendaActivities = [...state.agendaActivities, ...newItems];
            
            saveState();
            
            // Show confirmation and switch to agenda
            alert(`✅ ${newItems.length} activiteit(en) toegevoegd aan uw agenda!`);
            switchView('agenda');
        }

