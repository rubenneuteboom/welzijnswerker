        // Draw network visualization
        function drawNetwork() {
            const canvas = document.getElementById('networkCanvas');
            const ctx = canvas.getContext('2d');
            
            // Set actual size
            canvas.width = canvas.offsetWidth * 2;
            canvas.height = 800;
            ctx.scale(2, 2);

            const width = canvas.offsetWidth;
            const height = 400;
            const centerX = width / 2;
            const centerY = height / 2;

            // Clear
            ctx.clearRect(0, 0, width, height);

            // Draw connection lines first
            state.network.forEach((person, i) => {
                const angle = (i / state.network.length) * Math.PI * 2 - Math.PI / 2;
                const radius = person.type === 'professional' ? 140 : 100;
                const x = centerX + Math.cos(angle) * radius;
                const y = centerY + Math.sin(angle) * radius;

                ctx.beginPath();
                ctx.moveTo(centerX, centerY);
                ctx.lineTo(x, y);
                ctx.strokeStyle = typeColors[person.type] + '40';
                ctx.lineWidth = 2;
                ctx.stroke();
            });

            // Draw center (client)
            ctx.beginPath();
            ctx.arc(centerX, centerY, 35, 0, Math.PI * 2);
            ctx.fillStyle = '#4A90D9';
            ctx.fill();
            ctx.strokeStyle = '#fff';
            ctx.lineWidth = 3;
            ctx.stroke();

            ctx.fillStyle = '#fff';
            ctx.font = 'bold 14px system-ui';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('JIJ', centerX, centerY);

            // Draw network persons
            state.network.forEach((person, i) => {
                const angle = (i / state.network.length) * Math.PI * 2 - Math.PI / 2;
                const radius = person.type === 'professional' ? 140 : 100;
                const x = centerX + Math.cos(angle) * radius;
                const y = centerY + Math.sin(angle) * radius;

                // Circle
                const circleRadius = person.frequency === 'dagelijks' ? 28 : 
                                    person.frequency === 'wekelijks' ? 24 : 20;
                
                ctx.beginPath();
                ctx.arc(x, y, circleRadius, 0, Math.PI * 2);
                ctx.fillStyle = typeColors[person.type];
                ctx.fill();

                // Initial
                ctx.fillStyle = '#fff';
                ctx.font = 'bold 12px system-ui';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText(person.name.charAt(0).toUpperCase(), x, y);

                // Name below
                ctx.fillStyle = '#333';
                ctx.font = '11px system-ui';
                ctx.fillText(person.name, x, y + circleRadius + 12);
            });
        }

        // Calculate network type
        function getNetworkType() {
            const informal = state.network.filter(p => 
                ['familie', 'vriend', 'buur', 'collega'].includes(p.type)
            ).length;
            const formal = state.network.filter(p => p.type === 'professional').length;

            if (informal <= 1 && formal === 0) {
                return { type: 'eenpersoons', label: '🔴 Eenpersoons netwerk', className: 'eenpersoons' };
            } else if (formal === 0) {
                return { type: 'informeel', label: '🟠 Informeel netwerk', className: 'informeel' };
            } else if (informal > 0 && formal > 0) {
                return { type: 'gemengd', label: '🟡 Gemengd netwerk', className: 'gemengd' };
            } else {
                return { type: 'formeel', label: '🔵 Formeel netwerk', className: 'formeel' };
            }
        }

        // Update network type display
        function updateNetworkType() {
            const networkInfo = getNetworkType();
            const badge = document.getElementById('networkTypeBadge');
            badge.textContent = networkInfo.label;
            badge.className = `network-type-badge ${networkInfo.className}`;
        }

