        async function analyzeWithAI() {
            const hulpvraag = document.getElementById('hulpvraag').value;
            const wens = document.getElementById('wens').value;
            
            if (!hulpvraag) {
                alert('Vul eerst de hulpvraag in!');
                return;
            }

            // Show loading
            const loadingMsg = document.createElement('div');
            loadingMsg.id = 'aiLoading';
            loadingMsg.style.cssText = 'position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: white; padding: 30px; border-radius: 16px; box-shadow: 0 8px 32px rgba(0,0,0,0.2); z-index: 10000; text-align: center;';
            loadingMsg.innerHTML = '<div style="font-size: 3rem; margin-bottom: 15px;">🤖</div><div style="font-size: 1.2rem; font-weight: 600; margin-bottom: 10px;">AI analyseert de hulpvraag...</div><div style="color: #666;">Dit kan 5-10 seconden duren</div>';
            document.body.appendChild(loadingMsg);

            try {
                const apiKey = localStorage.getItem('openai_api_key');
                
                const prompt = `Je bent een SIJN (Sterk In Je Netwerk) expert. Analyseer de volgende hulpvraag en beoordeel elk van de 11 levensdomeinen op een schaal van 1-3:

1 = 🔴 Onvoldoende stabiel (acute problematiek, intensieve ondersteuning nodig)
2 = 🟡 Gedeeltelijk zelfstandig (kwetsbaar maar hanteerbaar, regelmatige ondersteuning)
3 = 🟢 Zelfstandig / stabiel (geen of minimale ondersteuning nodig)

Hulpvraag: "${hulpvraag}"
${wens ? `Wens: "${wens}"` : ''}

De 11 SIJN levensdomeinen zijn:
1. Geestelijke gezondheid
2. Financiën
3. Huisvesting
4. Sociaal netwerk
5. Dagbesteding (werk/opleiding)
6. Lichamelijke gezondheid
7. Verslaving
8. ADL-vaardigheden (zelfzorg, huishouden)
9. Huiselijke relaties
10. Maatschappelijke participatie
11. Justitie

Geef voor elk domein ALLEEN een score 1, 2 of 3. Als er geen informatie is, geef dan 0.
Antwoord in dit exacte JSON formaat:
{
  "geestelijk": 2,
  "financien": 1,
  "huisvesting": 3,
  "sociaal": 2,
  "dagbesteding": 2,
  "lichamelijk": 3,
  "verslaving": 3,
  "adl": 2,
  "huiselijk": 3,
  "participatie": 2,
  "justitie": 3
}`;

                const response = await fetch('https://api.openai.com/v1/chat/completions', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${apiKey}`
                    },
                    body: JSON.stringify({
                        model: 'gpt-4o-mini',
                        messages: [{
                            role: 'user',
                            content: prompt
                        }],
                        temperature: 0.3,
                        max_tokens: 500
                    })
                });

                if (!response.ok) {
                    throw new Error('API call failed: ' + response.status);
                }

                const data = await response.json();
                const aiResponse = data.choices[0].message.content;
                
                // Parse JSON from response
                const jsonMatch = aiResponse.match(/\{[\s\S]*\}/);
                if (!jsonMatch) {
                    throw new Error('Kon geen JSON vinden in AI response');
                }
                
                const scores = JSON.parse(jsonMatch[0]);
                
                // Apply scores
                Object.keys(scores).forEach(domainId => {
                    if (scores[domainId] > 0 && scores[domainId] <= 3) {
                        state.scores[domainId] = scores[domainId];
                        if (!state.domainDetails[domainId]) state.domainDetails[domainId] = {};
                        state.domainDetails[domainId].lastUpdated = new Date().toISOString();
                    }
                });
                
                saveState();
                
                // Remove loading
                document.getElementById('aiLoading').remove();
                
                // Show success and go to domains
                alert('✅ AI Analyse voltooid!\n\nDe domeinkaart is vooringevuld. Je kunt de scores nog aanpassen.');
                saveHulpvraag();
                goToScreen(3);
                
            } catch (error) {
                console.error('AI Analysis error:', error);
                document.getElementById('aiLoading').remove();
                alert('❌ AI Analyse mislukt\n\n' + error.message + '\n\nControleer je API key in de browser console of probeer opnieuw.');
            }
        }

