        function renderDashboardStats() {
            const scores = domains.map(d => state.scores[d.id] || 0);
            const filledScores = scores.filter(s => s > 0);
            
            // Gemiddelde (op schaal van 1-3)
            const avg = filledScores.length > 0 
                ? (filledScores.reduce((a, b) => a + b, 0) / filledScores.length).toFixed(1)
                : '-';
            
            // Laagste & Hoogste (1-3 schaal)
            const lowest = filledScores.length > 0 ? Math.min(...filledScores) : '-';
            const highest = filledScores.length > 0 ? Math.max(...filledScores) : '-';
            
            // Convert to emoji labels
            const lowestLabel = lowest === 1 ? '🔴' : lowest === 2 ? '🟡' : lowest === 3 ? '🟢' : '-';
            const highestLabel = highest === 1 ? '🔴' : highest === 2 ? '🟡' : highest === 3 ? '🟢' : '-';
            
            // Tel alle supporters over alle domeinen (nieuw systeem)
            let totalSupporters = 0;
            domains.forEach(d => {
                const details = state.domainDetails[d.id] || {};
                const supporters = details.supporters || [];
                totalSupporters += supporters.length;
            });
            
            // Update stats
            document.getElementById('avgScoreValue').textContent = avg;
            document.getElementById('lowestScoreValue').textContent = `${lowestLabel} ${lowest}`;
            document.getElementById('highestScoreValue').textContent = `${highestLabel} ${highest}`;
            document.getElementById('totalOndersteuners').textContent = totalSupporters;
            
            // Aandachtspunten box (score 1 = kritiek, score 2 = kwetsbaar)
            const criticalDomains = domains.filter(d => state.scores[d.id] === 1);
            const vulnerableDomains = domains.filter(d => state.scores[d.id] === 2);
            
            const attentionBox = document.getElementById('attentionBox');
            const attentionList = document.getElementById('attentionList');
            
            if (criticalDomains.length > 0 || vulnerableDomains.length > 0) {
                attentionBox.style.display = 'block';
                let html = '';
                
                if (criticalDomains.length > 0) {
                    html += '<li style="color: #dc2626; font-weight: 600;">🔴 Kritieke situaties:</li>';
                    html += criticalDomains.map(d => {
                        const label = getZelfredzaamheidLabel(d.id, 1);
                        return `<li style="margin-left: 20px;">${d.emoji} <strong>${d.name}</strong> - ${label.niveau}</li>`;
                    }).join('');
                }
                
                if (vulnerableDomains.length > 0) {
                    html += '<li style="color: #eab308; font-weight: 600; margin-top: 10px;">🟡 Kwetsbare domeinen:</li>';
                    html += vulnerableDomains.map(d => {
                        const label = getZelfredzaamheidLabel(d.id, 2);
                        return `<li style="margin-left: 20px;">${d.emoji} <strong>${d.name}</strong></li>`;
                    }).join('');
                }
                
                attentionList.innerHTML = html;
            } else {
                attentionBox.style.display = 'none';
            }
        }

