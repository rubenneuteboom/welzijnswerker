        // Navigate to screen
        function goToScreen(screenNum) {
            const config = getScreenConfig();
            state.currentScreen = screenNum;
            saveState();
            
            // Hide all screens
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            
            // Get screen id from config
            const screenConfig = config[screenNum - 1];
            if (screenConfig) {
                document.getElementById(`screen-${screenConfig.id}`).classList.add('active');
            }
            
            // Update progress steps
            renderProgressSteps();

            // Load content for each screen (LEAN workflow)
            const screenId = screenConfig ? screenConfig.id : '';
            if (screenId === 'hulpvraag') loadHulpvraagData();
            if (screenId === 'domains') renderDomains();
            if (screenId === 'network') renderDashboard();
            if (screenId === 'netwerkpositie') renderSIJNNetwerkkaartCompact();
            if (screenId === 'beweging') { 
                renderNetwerkBewegingDiagram(); 
                renderBewegingKeuzes(); 
            }
            if (screenId === 'interventies') renderInterventiesVoorBeweging();
            if (screenId === 'samenvatting') renderSamenvatting();

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

