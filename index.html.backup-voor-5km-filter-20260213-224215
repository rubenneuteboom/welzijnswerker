        // Sync sociaal netwerk score naar algemene score + stressCheck
        function syncSociaalNetwerkScore(domainId) {
            if (domainId !== 'sociaal') return;
            
            const details = state.domainDetails[domainId] || {};
            
            // Map sociaalScore naar 1-2-3 systeem
            if (details.sociaalScore === 'weinig') {
                state.scores[domainId] = 1; // 🔴
            } else if (details.sociaalScore === 'beperkt') {
                state.scores[domainId] = 2; // 🟡
            } else if (details.sociaalScore === 'voldoende') {
                state.scores[domainId] = 3; // 🟢
            }
            
            // Map sociaalStress naar stressCheck
            if (details.sociaalStress === 'isoleert') {
