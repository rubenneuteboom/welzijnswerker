            if (!state.history) return;
            state.history.kanbanLog.push({
                date: new Date().toISOString(),
                cardId: cardId,
                fromColumn: fromColumn,
                toColumn: toColumn
            });
        }

        function createAssessmentSnapshot() {
            if (!state.history) return;
            const networkInfo = getNetworkType();
            const ratings = state.network.map(p => state.ratings[p.id] || 5);
            const avgRating = ratings.length > 0 ? ratings.reduce((a, b) => a + b, 0) / ratings.length : 0;
            
            const sortedDomains = [...domains].sort((a, b) => 
                (state.scores[a.id] || 5) - (state.scores[b.id] || 5)
            );
            
            state.history.assessments.push({
                date: new Date().toISOString(),
                scores: {...state.scores},
                networkType: networkInfo.type,
                networkSize: state.network.length,
                avgRating: Math.round(avgRating * 10) / 10,
                lowestDomains: sortedDomains.slice(0, 3).map(d => d.id),
                kanbanStats: {
                    todo: state.kanbanCards.filter(c => c.column === 'todo').length,
                    doing: state.kanbanCards.filter(c => c.column === 'doing').length,
                    done: state.kanbanCards.filter(c => c.column === 'done').length
                }
            });
        }

        // Render progress steps dynamically
        function renderProgressSteps() {
            const config = getScreenConfig();
            const container = document.getElementById('progressSteps');
            
            container.innerHTML = config.map((step, i) => {
                const stepNum = i + 1;
                const isActive = stepNum === state.currentScreen;
                const isCompleted = stepNum < state.currentScreen;
                const isFuture = stepNum > state.currentScreen;
                const classes = [
                    'progress-step',
                    isActive ? 'active' : '',
                    isCompleted ? 'completed' : '',
                    isFuture ? 'future' : ''
                ].filter(Boolean).join(' ');
                
                return `
                    <div class="${classes}" data-step="${stepNum}" onclick="handleStepClick(${stepNum})">
                        <div class="step-circle">${step.emoji}</div>
                        <span class="step-label">${step.label}</span>
                    </div>
                `;
            }).join('');
        }

        // Handle click on progress step
        function handleStepClick(stepNum) {
            // Allow navigation to any step
            goToScreen(stepNum);
        }

        // Switch view (assessment / kanban / agenda)
        function switchView(view) {
            state.currentView = view;
            saveState();

            document.querySelectorAll('.view-section').forEach(s => s.classList.remove('active'));
            document.getElementById(`view-${view}`).classList.add('active');

            document.querySelectorAll('.view-tab').forEach(t => {
                t.classList.remove('active');
                if (t.dataset.view === view) t.classList.add('active');
            });

            if (view === 'kanban') {
                renderKanban();
            } else if (view === 'agenda') {
                renderAgenda();
            } else if (view === 'doelen') {
                renderDoelen();
            }
        }

