        function renderSpiderChart() {
            const canvas = document.getElementById('spiderChart');
            if (!canvas) return;
            
            const ctx = canvas.getContext('2d');
            if (spiderChart) spiderChart.destroy();

            const labels = domains.map(d => d.emoji + ' ' + d.name);
            const data = domains.map(d => state.scores[d.id] || 0);
            const colors = domains.map(d => {
                const score = state.scores[d.id] || 0;
                if (score === 1) return '#dc2626';  // 🔴 Rood
                if (score === 2) return '#eab308';  // 🟡 Geel
                if (score === 3) return '#10b981';  // 🟢 Groen
                return '#d1d5db';  // Grijs (niet ingevuld)
            });

            spiderChart = new Chart(ctx, {
                type: 'radar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Zelfredzaamheid',
                        data: data,
                        backgroundColor: 'rgba(46, 204, 113, 0.15)',
                        borderColor: '#2ECC71',
                        borderWidth: 2,
                        pointBackgroundColor: colors,
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointRadius: 8,
                        pointHoverRadius: 12
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    scales: {
                        r: {
                            min: 0,
                            max: 3,
                            ticks: {
                                stepSize: 1,
                                font: { size: 10 }
                            },
                            pointLabels: {
                                font: { size: 11 }
                            }
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                title: function(items) {
                                    const idx = items[0].dataIndex;
                                    return domains[idx].name;
                                },
                                label: function(item) {
                                    const score = item.raw;
                                    const label = getZelfredzaamheidLabel(domains[item.dataIndex].id, score);
                                    return `${label.niveau}`;
