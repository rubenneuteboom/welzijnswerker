        // Exporteer samenvatting
        function exportSamenvatting() {
            const stabilisatieLabels = {
                'stabiel': '🟢 Stabiel',
                'kwetsbaar': '🟡 Kwetsbaar',
                'direct-actie': '🔴 Direct actie nodig'
            };
            
            const netwerkInfo = getSIJNNetwerkPositie();
            
            const actienodigDomeinen = domains.filter(d => {
                const details = state.domainDetails[d.id] || {};
                return details.actieNodig === 'actie';
            });
            
            let text = '=== SIJN SCAN SAMENVATTING ===\n\n';
            text += `Datum: ${new Date().toLocaleDateString('nl-NL')}\n\n`;
            
            if (state.doelgroepen && state.doelgroepen.length > 0) {
                const doelgroepLabels = {
                    'ggz': '🧠 GGZ',
                    'jongeren': '👤 Jongeren',
                    'mantelzorgers': '🤝 Mantelzorgers',
                    'ouderen': '👴 Ouderen',
                    'multiproblem': '🔄 Multi-problematiek',
                    'sociaalmaatschappelijk': '🏘️ Sociaal-maatschappelijk'
                };
                text += `DOELGROEP: ${state.doelgroepen.map(d => doelgroepLabels[d] || d).join(', ')}\n\n`;
            }
            
            text += `NETWERKPOSITIE: ${netwerkInfo.label}\n`;
            text += `${netwerkInfo.beschrijving}\n\n`;
            
            if (actienodigDomeinen.length > 0) {
                text += 'ACTIE NODIG:\n';
                actienodigDomeinen.forEach(d => {
                    text += `- ${d.emoji} ${d.name}\n`;
                });
            }
            
            navigator.clipboard.writeText(text).then(() => {
                alert('✅ Samenvatting gekopieerd naar klembord!');
            }).catch(() => {
                alert('❌ Kon niet kopiëren. Selecteer handmatig.');
            });
        }
        
